{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-fetch-server"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "D:\\trans\\international_transport_app"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-sqlite", "--database", "D:\\trans\\international_transport_app\\database.db"],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "environment": {
        "BRAVE_API_KEY": ""
      },
      "enabled": true
    }
  }
}